+    def reliability_targets(self, batch):
+        """Return per-box CMCD reliability, defaulting to 1 for ordinary labels."""
+        reliability = batch.get("reliability")
+        if reliability is None:
+            reliability = torch.ones_like(batch["cls"])
+        return reliability.view(-1, 1).to(batch["cls"].device, non_blocking=True).clamp_(0.0, 1.0)
+
+    @staticmethod
+    def apply_reliability_to_scores(target_scores, target_gt_idx, gt_reliability):
+        """Weight positive assigned anchors by their matched teacher reliability."""
+        if gt_reliability.numel() == 0 or gt_reliability.shape[1] == 0:
+            return target_scores
+        indices = target_gt_idx.clamp(0, gt_reliability.shape[1] - 1)
+        weights = gt_reliability.squeeze(-1).gather(1, indices).unsqueeze(-1)
+        return target_scores * weights.to(target_scores.dtype)
+
