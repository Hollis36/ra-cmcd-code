+def scored_label_path(label_file):
+    """Return optional CMCD scored-label path for a standard YOLO label path."""
+    label_file = str(label_file)
+    src = f"{os.sep}labels{os.sep}"
+    dst = f"{os.sep}labels_scored{os.sep}"
+    if src not in label_file:
+        return label_file
+    return label_file.replace(src, dst, 1)
+
+
+def load_label_reliability(label_file, n_labels):
+    """Load per-box teacher reliability from labels_scored, defaulting to ones."""
+    default = np.ones((n_labels, 1), dtype=np.float32)
+    if n_labels == 0:
+        return np.zeros((0, 1), dtype=np.float32)
+
+    scored_file = scored_label_path(label_file)
+    if scored_file == str(label_file) or not Path(scored_file).is_file():
+        return default
+
+    rows = []
+    with open(scored_file) as f:
+        for line in f.read().strip().splitlines():
+            if line.strip():
+                rows.append(line.split())
+    if len(rows) != n_labels or any(len(row) < 7 for row in rows):
+        return default
+    return np.array([[float(row[6])] for row in rows], dtype=np.float32).clip(0.0, 1.0)
 
 
